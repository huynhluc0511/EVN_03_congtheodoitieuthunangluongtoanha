# SQL Server: chỉnh SERVER theo máy của bạn: localhost, .\\SQLEXPRESS, (localdb)\\MSSQLLocalDB
DB_SERVER=localhost
DB_NAME=EnergyPortalDB
# Chọn 1 trong 2 kiểu xác thực:
DB_TRUSTED_CONNECTION=yes
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Đổi chuỗi này trước khi dùng thật
SESSION_SECRET=change-this-to-a-long-random-secret
APP_ENV=development
